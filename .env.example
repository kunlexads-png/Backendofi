# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ofi_cocoa_warehouse

# JWT Security
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API for Warehouse AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# React + Vite Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Secure File Uploads Directory
UPLOAD_DIR=uploads
